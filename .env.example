# Public/client Supabase configuration.
# VITE_* values are embedded into the browser bundle and MUST NOT contain secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase configuration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SECRET — server runtime only. Never prefix with VITE_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
